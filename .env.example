# ==============================================================================
# CNPydge - Configurações de Ambiente para Docker Compose
# ==============================================================================

# Diretório local no host para persistência dos arquivos Parquet gerados
CNPYDGE_DATA_DIR=./dados_parquet

# Perfil declarativo de retenção de armazenamento em disco temporário:
#   - balanced_rolling_eviction (Padrão: expurga zip e csv sob demanda, ~2-3 GB no pico)
#   - performance_batch_retain (preserva intermediários em disco rápido)
#   - archival_permanent_zip (preserva zips originais da Receita Federal)
CNPYDGE_RETENTION_PROFILE=balanced_rolling_eviction

# Limites de contenção de recursos computacionais do contêiner
CNPYDGE_CPU_LIMIT=4.0
CNPYDGE_MEMORY_LIMIT=4096M

